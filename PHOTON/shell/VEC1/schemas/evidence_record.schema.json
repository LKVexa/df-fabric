{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "VEC/EVIDENCE_RECORD/3.1.0",
  "title": "VEC Evidence Record v3.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_id",
    "work_item_id",
    "kind",
    "producer",
    "artifact_sha256",
    "claims"
  ],
  "properties": {
    "schema": {
      "const": "VEC/EVIDENCE_RECORD/3.1.0"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "work_item_id": {
      "type": "string",
      "pattern": "^VEC-[0-9]{3}-P[0-9]{3}(?:-[A-T])?$"
    },
    "kind": {
      "enum": [
        "ARTIFACT",
        "TEST",
        "TRACE",
        "LOG",
        "DIFF",
        "HASH",
        "REVIEW",
        "METRIC",
        "SCREENSHOT",
        "RECEIPT",
        "OTHER"
      ]
    },
    "producer": {
      "type": "string"
    },
    "artifact_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}