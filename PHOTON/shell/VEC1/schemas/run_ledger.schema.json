{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "VEC/RUN_LEDGER/3.1.0",
  "title": "VEC Run Ledger v3.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "contract_version",
    "source_package_sha256",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "VEC/RUN_LEDGER/3.1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "const": "3.1.0"
    },
    "source_package_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "work_item_id",
          "state"
        ],
        "properties": {
          "work_item_id": {
            "type": "string"
          },
          "idempotency_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "enum": [
              "PENDING",
              "RUNNING",
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_APPLICABLE"
            ]
          },
          "result_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}